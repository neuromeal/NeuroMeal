<!--index.html-->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>NeuroMeal | Food, Medicine & the Brain</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f5f7f4;
            color: #24302a;
            line-height: 1.6;
        }

        header {
            background-color: #ffffff;
            border-bottom: 1px solid #dce3de;
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 28px;
            font-weight: bold;
            color: #315c4b;
        }

        nav a {
            color: #40544a;
            text-decoration: none;
            margin-left: 25px;
            font-size: 15px;
        }

        nav a:hover {
            color: #315c4b;
        }

        .hero {
            padding: 100px 8%;
            text-align: center;
            background: linear-gradient(
                135deg,
                #e9f1ec,
                #f8faf8
            );
        }

        .hero h1 {
            font-size: 64px;
            color: #315c4b;
            margin-bottom: 15px;
        }

        .hero h2 {
            font-size: 25px;
            font-weight: normal;
            color: #50645a;
            margin-bottom: 25px;
        }

        .hero p {
            max-width: 650px;
            margin: 0 auto 35px;
            font-size: 18px;
            color: #53635b;
        }

        .button {
            display: inline-block;
            padding: 13px 25px;
            background-color: #315c4b;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
        }

        .button:hover {
            background-color: #244638;
        }

        section {
            padding: 70px 8%;
            max-width: 1200px;
            margin: auto;
        }

        section h2 {
            text-align: center;
            font-size: 32px;
            margin-bottom: 15px;
            color: #315c4b;
        }

        .section-intro {
            text-align: center;
            max-width: 650px;
            margin: 0 auto 45px;
            color: #637169;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .card {
            background-color: white;
            padding: 30px;
            border-radius: 14px;
            border: 1px solid #dce3de;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        }

        .card h3 {
            margin-bottom: 10px;
            color: #315c4b;
            font-size: 21px;
        }

        .card p {
            color: #617068;
        }

        .about {
            background-color: #e9f1ec;
            max-width: none;
        }

        .about-content {
            max-width: 800px;
            margin: auto;
            text-align: center;
        }

        .disclaimer {
            background-color: #fffdf5;
            border-top: 1px solid #eee6c9;
            border-bottom: 1px solid #eee6c9;
            text-align: center;
            padding: 30px 8%;
            color: #6c674f;
            font-size: 14px;
        }

        footer {
            background-color: #24302a;
            color: #dce3de;
            text-align: center;
            padding: 30px;
            font-size: 14px;
        }

        @media (max-width: 750px) {
            header {
                flex-direction: column;
                gap: 15px;
            }

            nav a {
                margin: 0 8px;
            }

            .hero h1 {
                font-size: 45px;
            }

            .hero h2 {
                font-size: 20px;
            }

            .cards {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <header>
        <div class="logo">NeuroMeal</div>

        <nav>
            <a href="#explore">Explore</a>
            <a href="#about">About</a>
        </nav>
    </header>


    <main>

        <section class="hero">
            <h1>NeuroMeal</h1>

            <h2>Where food, medicine, and the brain intersect.</h2>

            <p>
                Explore the biology behind food and medication interactions,
                from drug metabolism to neurotransmitters and the
                blood-brain barrier.
            </p>

            <a class="button" href="#explore">Explore the Science</a>
        </section>


        <section id="explore">

            <h2>Explore NeuroMeal</h2>

            <p class="section-intro">
                Learn how the things we eat can interact with medications
                and how those interactions can affect the body and brain.
            </p>

            <div class="cards">

                <div class="card">
                    <h3>🧠 Neuroscience</h3>

                    <p>
                        Discover how medications interact with
                        neurotransmitters, receptors, neurons, and
                        the blood-brain barrier.
                    </p>
                </div>


                <div class="card">
                    <h3>💊 Medications</h3>

                    <p>
                        Learn how common medications work, how they are
                        processed by the body, and what can influence
                        their effects.
                    </p>
                </div>


                <div class="card">
                    <h3>🍊 Food Interactions</h3>

                    <p>
                        Explore documented interactions between foods
                        and medications and the biological mechanisms
                        behind them.
                    </p>
                </div>

            </div>

        </section>


        <section class="about" id="about">

            <div class="about-content">

                <h2>About NeuroMeal</h2>

                <p>
                    NeuroMeal is an independent educational project
                    exploring pharmacology, neuroscience, biology,
                    and the relationship between food and medication.
                </p>

                <br>

                <p>
                    The goal is to make complicated scientific concepts
                    easier to understand while connecting molecular
                    biology to the way medications actually affect
                    the human body.
                </p>

            </div>

        </section>


        <div class="disclaimer">

            <strong>Educational Disclaimer:</strong>

            NeuroMeal is an educational resource and does not provide
            medical advice. Information presented on this website should
            not be used to make decisions about starting, stopping, or
            changing medication. Always consult a qualified healthcare
            professional and official medication information for
            personal medical questions.

        </div>

    </main>


    <footer>

        <p>NeuroMeal © 2026</p>

        <p>Food × Medicine × Neuroscience</p>

    </footer>

</body>
</html>
